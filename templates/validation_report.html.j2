<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Network Validation Report — {{ report_data.change_ticket }}</title>
  <style>
    :root {
      --pass: #22c55e;
      --fail: #ef4444;
      --warn: #f59e0b;
      --bg: #f8fafc;
      --card: #ffffff;
      --border: #e2e8f0;
      --text: #1e293b;
      --muted: #64748b;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg); color: var(--text); line-height: 1.6;
      padding: 2rem; max-width: 1200px; margin: 0 auto;
    }
    header {
      background: linear-gradient(135deg, #1e40af, #3b82f6);
      color: white; padding: 2rem; border-radius: 12px; margin-bottom: 2rem;
    }
    header h1 { font-size: 1.5rem; margin-bottom: 0.5rem; }
    header .meta { display: flex; gap: 2rem; flex-wrap: wrap; font-size: 0.9rem; opacity: 0.9; }
    .summary-cards {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem; margin-bottom: 2rem;
    }
    .card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 8px; padding: 1.5rem; text-align: center;
    }
    .card .number { font-size: 2rem; font-weight: 700; }
    .card .label { font-size: 0.85rem; color: var(--muted); text-transform: uppercase; }
    .card.pass .number { color: var(--pass); }
    .card.fail .number { color: var(--fail); }
    .card.warn .number { color: var(--warn); }
    .host-section {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 8px; margin-bottom: 1.5rem; overflow: hidden;
    }
    .host-header {
      background: #f1f5f9; padding: 1rem 1.5rem; font-weight: 600;
      display: flex; justify-content: space-between; align-items: center;
      cursor: pointer; border-bottom: 1px solid var(--border);
    }
    .host-header .badge {
      font-size: 0.75rem; padding: 0.25rem 0.75rem; border-radius: 999px;
      font-weight: 600; text-transform: uppercase;
    }
    .badge-pass { background: #dcfce7; color: #166534; }
    .badge-changed { background: #fef3c7; color: #92400e; }
    .checks-table {
      width: 100%; border-collapse: collapse; font-size: 0.9rem;
    }
    .checks-table th {
      text-align: left; padding: 0.75rem 1.5rem; background: #f8fafc;
      border-bottom: 1px solid var(--border); font-weight: 600;
      color: var(--muted); font-size: 0.8rem; text-transform: uppercase;
    }
    .checks-table td {
      padding: 0.75rem 1.5rem; border-bottom: 1px solid var(--border);
      vertical-align: top;
    }
    .status-unchanged { color: var(--pass); font-weight: 600; }
    .status-changed { color: var(--warn); font-weight: 600; }
    .diff-toggle {
      font-size: 0.8rem; color: #3b82f6; cursor: pointer;
      text-decoration: underline; border: none; background: none;
    }
    .diff-content {
      display: none; background: #f1f5f9; padding: 1rem;
      border-radius: 4px; margin-top: 0.5rem;
      font-family: monospace; font-size: 0.8rem; white-space: pre-wrap;
      max-height: 300px; overflow-y: auto;
    }
    .diff-content.visible { display: block; }
    footer {
      text-align: center; padding: 2rem; color: var(--muted);
      font-size: 0.85rem;
    }
    @media print {
      body { padding: 0; }
      .diff-content { display: block !important; max-height: none; }
      header { background: #1e40af !important; -webkit-print-color-adjust: exact; }
    }
  </style>
</head>
<body>

<header>
  <h1>Network Change Validation Report</h1>
  <div class="meta">
    <span>Change Ticket: <strong>{{ report_data.change_ticket }}</strong></span>
    <span>Pre-Validation: <strong>{{ report_data.pre_metadata.timestamp }}</strong></span>
    <span>Post-Validation: <strong>{{ report_data.post_metadata.timestamp }}</strong></span>
    <span>Executed By: <strong>{{ report_data.post_metadata.executed_by | default('N/A') }}</strong></span>
  </div>
</header>

{% set total_hosts = report_data.results | length %}
{% set ns = namespace(total_checks=0, changed=0, unchanged=0, hosts_changed=0) %}
{% for host_result in report_data.results %}
  {% set ns.total_checks = ns.total_checks + host_result.diffs | length %}
  {% set host_changes = host_result.diffs | selectattr('status', 'eq', 'CHANGED') | list | length %}
  {% set ns.changed = ns.changed + host_changes %}
  {% set ns.unchanged = ns.unchanged + (host_result.diffs | selectattr('status', 'eq', 'UNCHANGED') | list | length) %}
  {% if host_changes > 0 %}
    {% set ns.hosts_changed = ns.hosts_changed + 1 %}
  {% endif %}
{% endfor %}

<div class="summary-cards">
  <div class="card">
    <div class="number">{{ total_hosts }}</div>
    <div class="label">Hosts Validated</div>
  </div>
  <div class="card">
    <div class="number">{{ ns.total_checks }}</div>
    <div class="label">Total Checks</div>
  </div>
  <div class="card pass">
    <div class="number">{{ ns.unchanged }}</div>
    <div class="label">Unchanged</div>
  </div>
  <div class="card {% if ns.changed > 0 %}warn{% else %}pass{% endif %}">
    <div class="number">{{ ns.changed }}</div>
    <div class="label">Changed</div>
  </div>
  <div class="card {% if ns.hosts_changed > 0 %}warn{% else %}pass{% endif %}">
    <div class="number">{{ ns.hosts_changed }} / {{ total_hosts }}</div>
    <div class="label">Hosts With Changes</div>
  </div>
</div>

{% for host_result in report_data.results | sort(attribute='host') %}
{% set host_changes = host_result.diffs | selectattr('status', 'eq', 'CHANGED') | list %}
<div class="host-section">
  <div class="host-header" onclick="this.parentElement.querySelector('.checks-table-wrap').classList.toggle('collapsed')">
    <span>{{ host_result.host }}</span>
    <span class="badge {% if host_changes | length > 0 %}badge-changed{% else %}badge-pass{% endif %}">
      {% if host_changes | length > 0 %}
        {{ host_changes | length }} changed
      {% else %}
        All Passed
      {% endif %}
    </span>
  </div>
  <div class="checks-table-wrap">
    <table class="checks-table">
      <thead>
        <tr>
          <th>Check</th>
          <th>Status</th>
          <th>Details</th>
        </tr>
      </thead>
      <tbody>
        {% for diff in host_result.diffs | sort(attribute='check') %}
        <tr>
          <td><strong>{{ diff.check }}</strong></td>
          <td class="status-{{ diff.status | lower }}">{{ diff.status }}</td>
          <td>
            {% if diff.status == 'CHANGED' %}
            <button class="diff-toggle" onclick="this.nextElementSibling.classList.toggle('visible')">
              Show Diff
            </button>
            <div class="diff-content">
--- PRE ---
{{ diff.pre | default('N/A') }}

--- POST ---
{{ diff.post | default('N/A') }}
            </div>
            {% else %}
            <span style="color: var(--muted)">No changes detected</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endfor %}

<footer>
  <p>Generated by Network Validation Workflow | {{ report_data.change_ticket }} |
     {{ ansible_date_time.iso8601 | default('') }}</p>
  <p>This report is intended for audit and security review purposes.</p>
</footer>

<script>
// Allow collapsing host sections
document.querySelectorAll('.host-header').forEach(function(el) {
  el.style.cursor = 'pointer';
});
</script>

</body>
</html>
